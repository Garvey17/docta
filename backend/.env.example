# Server & Environment
APP_NAME="docta Backend API"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Supabase Infrastructure
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Security (Optional override for Supabase JWT verification)
SECRET_KEY=docta-dev-jwt-secret-key-fargate-ready-123456
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Storage & Uploads
UPLOAD_DIR=uploads
SUPABASE_STORAGE_BUCKET=meals

# Live AI and RAG services (mock providers are disabled)
USE_MOCK_AI=false
USE_MOCK_RAG=false
CV_SERVICE_URL=http://127.0.0.1:8001
OPENAI_API_KEY=your-openai-api-key
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=composite_dishes
