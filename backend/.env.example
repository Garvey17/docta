# Server & Environment
APP_NAME="docta Backend API"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Supabase Infrastructure
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Security (Optional override for Supabase JWT verification)
SECRET_KEY=docta-dev-jwt-secret-key-fargate-ready-123456
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Storage & Uploads
UPLOAD_DIR=uploads
SUPABASE_STORAGE_BUCKET=meals

# Mock Flags & External AI/RAG Services
USE_MOCK_AI=true
USE_MOCK_RAG=true
CV_SERVICE_URL=
RAG_SERVICE_URL=
