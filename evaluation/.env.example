# Docta backend must be running locally or point this to a reachable API.
DOCTA_API_URL=http://127.0.0.1:8000

# Number of benchmark prompts to run: choose 30 for the default suite or 50 for all cases.
EVAL_QUESTION_COUNT=30

# The evaluated chat model and judge model are independent. Both default to OpenAI mini.
DEEPEVAL_JUDGE=openai
DEEPEVAL_MODEL=gpt-4o-mini

# Optional local judge (free API usage, slower and less independent from local Qwen).
DEEPEVAL_OLLAMA_MODEL=qwen3:4b
DEEPEVAL_OLLAMA_BASE_URL=http://localhost:11434
